	column 'FAVORITES (SKU COL)' =
			
			
			SWITCH(TRUE()
			    ,'__SKU__'[_serial] in {
			                // first showcase
			                                "DXBSI25011295"
			                                ,"DXBSI25013822"
			                                ,"DXBSI25015236"
			                                ,"DXBSI25015467"
			                                ,"DXBAI25015576"
			                                ,"DXBSI25015761"
			
			                // second showcase
			
			                            ,"DOHAI25002787-2"
			                            ,"DOHAI25002787-3"
			                            ,"DOHAI25002787-5"
			                            ,"DOHAI25002787-4"
			    }
			        ,"FAVORITE SHIPMENT"
			    ,BLANK())
		displayFolder: __COL__
		lineageTag: 0ba3cfdb-ccd1-4a92-a3fc-66d9c017d55a
