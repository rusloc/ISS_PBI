	partition __SKU__ = m
		mode: import
		queryGroup: MAIN
		source = ```
				let
				  
				    Source = PostgreSQL.Database("c-powerbicosmos.k4mjimliu3npzv.postgres.cosmos.azure.com", "powerbi", 
				    
				    					[Query = SKU_SRC[_code]{0}])
				
					,_fillNulls = (x) => let  
				
												_input = x ?? "NA"
										in 
												_input,
				
					_replaceNulls = Table.TransformColumns(Source, {{"_sku", _fillNulls}})
				in
				    _replaceNulls
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

