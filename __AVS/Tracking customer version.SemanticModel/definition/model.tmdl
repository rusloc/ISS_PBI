model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup MAIN

	annotation PBI_QueryGroupOrder = 0

queryGroup RLS

	annotation PBI_QueryGroupOrder = 1

queryGroup 'SQL SRC'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["__MAIN__","__CONTAINER__","__SKU__","__VISIBILITY","customCalendar","_calendar","__CLIENTS_SKU__","__CLIENTS_DIM__","__CLIENTS_MAIN__","_ETA_MAX_DATE","MAIN_SRC","SKU_SRC","CONTAINER_SRC"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop","CalcGroup","DevMode"]

annotation __TEdtr = 1

ref table __MAIN__
ref table __SKU__
ref table SKU_param
ref table CONTAINER_param
ref table SHIPMENT_param
ref table _calendar
ref table _DATE_SWITCHER
ref table _ROLE
ref table __CONTAINER__
ref table __VISIBILITY

ref role CompanyID_MAN
ref role CompanyID_AUTO

ref cultureInfo en-US

