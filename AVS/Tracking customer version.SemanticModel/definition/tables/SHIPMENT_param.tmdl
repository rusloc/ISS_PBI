	/// Column is used in RLS roles for managing visuals in embedded report: when AUTO role is selected -> parameter table is filtered down by using _ETA_AUTO column
	column _ETA_AUTO =
			
			
			SWITCH(TRUE()
			    ,'SHIPMENT_param'[SHIPMENT_PARAM Order] in {60,127,135}
			        ,0
			    ,1)
		formatString: 0
		lineageTag: 71f950b7-3006-46ee-bf6d-3c31c938e3c5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Column is used in RLS roles for managing visuals in embedded report: when MAN role is selected -> parameter table is filtered down by using _ETA_MAN column
	column _ETA_MAN =
			
			
