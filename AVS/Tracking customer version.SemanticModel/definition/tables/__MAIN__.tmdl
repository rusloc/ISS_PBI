	column '_last ETA/ETD change group' = ```
			
			
			VAR _dif = 
			        IFERROR(
			            DATEDIFF([_change_date], NOW(), DAY)
			            ,"Initialized")
			
			RETURN
			SWITCH(TRUE()
			    ,_dif = "Initialized"
			        ,"Initialized"
			    ,_dif <= 1
			        ,"Last day"
			    ,_dif <= 3 
			        ,"Last 3 days"
			    ,_dif <= 7 
			        ,"Last 7 days"
			    ,"More than 7 days")
			```
		displayFolder: __FX_COL__
		lineageTag: 8b5bd39c-c548-4ff7-90c8-5527475febe1
		summarizeBy: none

