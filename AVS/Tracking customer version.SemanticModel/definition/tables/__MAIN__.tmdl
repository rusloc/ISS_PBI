	column '_container total charge weight (COLUMN)' =
			
			
			SWITCH(TRUE()
			    ,'__MAIN__'[_service_type_short] = "AIR"
			        ,CALCULATE(SUM('__MAIN__'[chargeable_weight]))
			    ,COALESCE('__MAIN__'[container_chargeable_weight],'__MAIN__'[_cargo_chargeable_weight],'__MAIN__'[chargeable_weight])
			)
		displayFolder: __FX_COL__
		lineageTag: 59de7852-7f2c-4d78-b8e8-488dee486bab
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'container packages (COLUMN)' =
			
			
			SWITCH(TRUE()
			    ,'__MAIN__'[_service_type_short] = "AIR"
			        ,COALESCE('__MAIN__'[package_count], 0)
			    ,COALESCE('__MAIN__'[container_packages], '__MAIN__'[_packages])
			)
		formatString: 0
		displayFolder: __FX_COL__
		lineageTag: 30fe9b3c-94cc-4217-8638-652f5d7d3b00
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '_actual status (COLUMN)' =
			
			
