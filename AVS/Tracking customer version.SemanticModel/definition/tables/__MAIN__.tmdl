	measure '_shipment count (main)' = ```
			
			
			VAR _role = FIRSTNONBLANK('_ROLE'[role],1)
			VAR _dateType = FIRSTNONBLANK('_DATE_SWITCHER'[Date switcher params],1)
			
			RETURN
			        SWITCH(TRUE()
			    // basic filter ALL = show absolutely all shipments
			            ,_dateType = "All"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,'__MAIN__'[_all] = 1)
			    // Initialized = loading_date (departure date) is NULL
			            ,_dateType = "Initialized"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no])))
			    // basic filter CREATION DATE = shows shipments enter date in Focus
			            ,_dateType = "Creation date"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[creation_date]))
			            ,_dateType = "Arrival date"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[arrival_date]))
			            ,_dateType = "Departure date"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[loading_date]))
			            ,_dateType = "ETA date" && _role = "man"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[eta_date]))
			            ,_dateType = "ETA date" && _role = "auto"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[_eta_auto_date]))
			            ,_dateType = "ETD date" && _role = "man"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                    ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[etd_date]))
			            ,_dateType = "ETD date" && _role = "auto"
			                ,CALCULATE(
			                    COUNTROWS(VALUES('__MAIN__'[serial_no]))
			                ,USERELATIONSHIP('_calendar'[Date],'__MAIN__'[_etd_auto_date]))
			        )
			
			```
		displayFolder: __FX__
		lineageTag: 57202319-49d9-452a-b924-0cd8d02ddf18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

