	partition __MAIN__ = m
		mode: import
		queryGroup: MAIN
		source = ```
				let
				   
				    Source = PostgreSQL.Database("c-powerbicosmos.k4mjimliu3npzv.postgres.cosmos.azure.com", "powerbi", 
				    
				    					[Query = MAIN_SRC[_code]{0}]), 
				
				   
				    dropCols = Table.RemoveColumns(Source,{"row_id", "cache_id", "contact_id", "contract_branch_id", "updated_at","equipment_details", "status_updates", "cargo", "latest_status","co2_emission_details"}),
				
					_wakeoTracked = Table.AddColumn(dropCols, "_isWakeoTracked", (x) => if x[wakeo_id] <> null then "Tracked" else null),
				    _dropWakeoID = Table.RemoveColumns(_wakeoTracked,{"wakeo_id"}),
				    _dateType = Table.TransformColumnTypes(_dropWakeoID,{{"created_at", type date}, {"container_chargeable_weight", type number}, {"_arrival_date_auto", type date}
																		, {"_etd_auto_date", type date}, {"_eta_auto_date", type date}, {"creation_date", type date}, {"etd_date", type date}
																		, {"pta_date", type date}, {"ptd_date", type date}, {"pickup_date", type date}, {"eta_wakeo_date", type date}
																		, {"etd_wakeo_date", type date}, {"arrival_date", type date}, {"eta_date", type date}, {"eta_plus_ten_days", type date}
																		, {"calculated_arrival", type date}, {"calculated_eta", type date}}),
				    #"Removed Columns" = Table.RemoveColumns(_dateType,{"wakeo_updates","port_of_discharge","port_of_discharge_name","gate_out_date", 
																		"destination_port","destination_port_name","destination_port_locode",
																		 "origin_port","origin_port_name","origin_port_locode"
																		 ,"extra_local_handling"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"loading_date", type date}})
				
				in
					#"Changed Type"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

