# Whitelist mode (2026-09-12): nothing is tracked except the root files below and __DATA/_SRC/_SQL/.
/*
!/.gitignore
!/CLAUDE.md
!/README.md
!/__DATA/
/__DATA/*
!/__DATA/_SRC/
/__DATA/_SRC/*
!/__DATA/_SRC/_SQL/
# Pre-edit copies under Rule #1 stay local, even inside the tracked folder.
__backup__/
*.bak
